RewriteEngine On

# Pastikan mod_rewrite aktif
# RewriteBase tidak wajib jika menggunakan RewriteRule yang relatif, 
# tapi jika ingin menggunakan, pastikan jalurnya tepat.
RewriteBase /SistemInformasiSumberDaya-Kelompok2/public/

# 1. Lindungi folder sensitif agar tidak bisa diakses lewat browser
RewriteRule ^(.*/)?\.git+ - [F,L]

# 2. Set halaman indeks default ke index.php
DirectoryIndex index.php

# 3. Direct URL root public/ ke index.php dengan parameter route=
RewriteRule ^$ index.php?route= [QSA,L]

# 4. Jika file, direktori, atau link simbolik beneran ada, buka filenya (CSS, JS, Gambar)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-l

# 5. Kirim semua permintaan lain ke index.php
# Gunakan [QSA] agar parameter query lain (seperti ?id=1) tetap terbaca
# Gunakan [L] untuk menghentikan pemrosesan aturan lain jika ini sudah terpenuhi
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]

# 4. Caching & Expiration Headers untuk Aset Statis (Gambar, CSS, JS, Fonts)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # Images & Media — harmonized with root .htaccess (1 year)
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Styles & Scripts — 1 month with versioned cache busting
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # Web Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # CSS & JS with immutable (versioned via ?v= query string)
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
    
    # Images & Media with immutable
    <FilesMatch "\.(webp|png|jpg|jpeg|gif|ico|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # Vary: Accept-Encoding for proper proxy caching
    <FilesMatch "\.(css|js|html|xml|json|svg)$">
        Header append Vary Accept-Encoding
    </FilesMatch>
</IfModule>