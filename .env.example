APP_NAME="Sistem Management Sumber Daya"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/SistemInformasiSumberDaya-Kelompok2

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistem_manajemen_sumber_daya
DB_USERNAME=root
DB_PASSWORD=

# -------------------------------------------------------------
# KONFIGURASI EMAIL PENERIMA NOTIFIKASI FORM KONTAK
# -------------------------------------------------------------
# Pilihan SUMBER EMAIL PENERIMA:
# - 'kontak' : Otomatis gunakan email resmi yang diatur di menu Kontak (rekomendasi & dinamis)
# - 'env'    : Gunakan email yang tertulis di ADMIN_EMAIL di bawah ini
CONTACT_EMAIL_SOURCE=kontak

# Email penerima admin (digunakan jika CONTACT_EMAIL_SOURCE=env atau fallback jika kontak belum diset)
ADMIN_EMAIL=admin@example.com

# Konfigurasi Server SMTP Pengiriman Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=admin@example.com
SMTP_PASSWORD=

# Jika nanti ada API Key atau setting lain, taruh di sini
