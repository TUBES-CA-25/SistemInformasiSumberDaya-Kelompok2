<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /SistemInformasiSumberDaya-Kelompok2/

    # Set halaman indeks default ke public/index.php
    DirectoryIndex public/index.php

    # Direct URL root (saat diakses tanpa nama file) ke public/index.php dengan parameter route
    RewriteRule ^$ public/index.php?route= [QSA,L]

    # Jika mengakses file atau direktori fisik yang benar-benar ada di root, jangan di-rewrite
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Rewrite semua permintaan lainnya ke public/index.php dengan parameter route
    RewriteRule ^(.*)$ public/index.php?route=$1 [QSA,L]
</IfModule>
