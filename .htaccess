<IfModule mod_rewrite.c>
    RewriteEngine On

    # Set halaman indeks default ke public/index.php
    DirectoryIndex public/index.php

    # Stop rewriting if request is already targeting public/ or is an existing file/directory
    RewriteCond %{REQUEST_URI} ^/public/ [NC,OR]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Direct URL root ke public/index.php dengan parameter route
    RewriteRule ^$ public/index.php?route= [QSA,L]

    # Rewrite semua permintaan lainnya ke public/index.php dengan parameter route
    RewriteRule ^(.*)$ public/index.php?route=$1 [QSA,L]
</IfModule>

# GZIP Compression untuk mempercepat transfer file (FCP & LCP)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml font/woff2 font/woff
</IfModule>

# Browser Caching untuk Aset Statis (CSS, JS, Gambar, Font)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # Gambar & Media
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Styles & Scripts
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # Web Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# Cache-Control Headers with immutable for versioned assets
<IfModule mod_headers.c>
    # Static assets with version query string (e.g. style.css?v=123) — immutable
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
    
    # Images & Media — long cache with immutable
    <FilesMatch "\.(webp|png|jpg|jpeg|gif|ico|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # Fonts — long cache with immutable
    <FilesMatch "\.(woff2|woff|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # Vary: Accept-Encoding for proper proxy caching
    <FilesMatch "\.(css|js|html|xml|json|svg)$">
        Header append Vary Accept-Encoding
    </FilesMatch>
</IfModule>

# ETag for cache validation
<IfModule mod_headers.c>
    FileETag MTime Size
</IfModule>

# Keep-Alive for connection reuse
<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>
